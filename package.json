{
	"name": "mash",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "MPMB character sheet scripts by book and creator",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=26.13.0",
		"pnpm": ">=12.6.0"
	},
	"scripts": {
		"validate": "node tools/validate/src/cli.mjs",
		"test": "pnpm -r test",
		"lint": "eslint tools *.mjs && pnpm run lint:md",
		"lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
		"format": "prettier --write \"2014/**/*.js\" \"2024/**/*.js\" \"tools/**/*.{mjs,json}\" \"*.{json,jsonc,yml,yaml,mjs}\"",
		"format:check": "prettier --check \"2014/**/*.js\" \"2024/**/*.js\" \"tools/**/*.{mjs,json}\" \"*.{json,jsonc,yml,yaml,mjs}\"",
		"bundle": "node tools/bundle/src/cli.mjs",
		"bundle:check": "node tools/bundle/src/cli.mjs --check",
		"compare": "node tools/bundle/src/compare-cli.mjs"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"globals": "catalog:",
		"lefthook": "2.2.2",
		"markdownlint-cli2": "0.24.0",
		"prettier": "3.9.10"
	}
}
